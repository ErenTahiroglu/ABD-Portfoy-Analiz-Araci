# ═══════════════════════════════════════════════════════════════════════════
# ABD Portföy Analiz Aracı – Çevre Değişkenleri (.env.example)
# ═══════════════════════════════════════════════════════════════════════════
# Bu dosyayı .env olarak kopyalayın ve gerekli değerleri girin:
#   Windows: copy .env.example .env
#   Unix   : cp .env.example .env

# Alpha Vantage API key (ücretsiz: https://www.alphavantage.co/support/#api-key)
# Opsiyonel — enflasyon düzeltmesi için önerilir
ALPHA_VANTAGE_KEY=your_key_here

# Mock/Offline Modu (Archived projeler için dış API'lar kırılsa bile çalışsın)
# Değerler: true, false, 1, 0, yes, no
# true → mock_data/*.csv dosyalarından veri okunur
# false → çevrimiçi API'lardan veri çekilir (varsayılan)
USE_MOCK_DATA=false
